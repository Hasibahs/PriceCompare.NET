<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:PriceComparisonApp.Models"
             x:Class="PriceComparisonApp.MainPage">

    <ContentPage.Resources>
        <Style x:Key="CardStyle" TargetType="Frame">
            <Setter Property="Padding" Value="10" />
            <Setter Property="Margin" Value="5" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="BackgroundColor" Value="White" />
            <Setter Property="HasShadow" Value="True" />
        </Style>
    </ContentPage.Resources>

    <VerticalStackLayout Padding="20">

        <SearchBar Placeholder="Search products..." 
                   x:Name="ProductSearchBar"
                   SearchButtonPressed="OnSearchButtonPressed" />

        <CollectionView x:Name="ProductResultsView" SelectionMode="None">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical" Span="3" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:ProductResult">
                    <Frame Style="{StaticResource CardStyle}">
                        <VerticalStackLayout Spacing="5">

                            <!-- ✅ Clickable Product Title -->
                            <!-- ✅ Clickable Product Title -->
                            <Label Text="{Binding ProductName}"
       FontAttributes="Bold"
       TextColor="Blue"
       TextDecorations="Underline">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer 
            Tapped="OnProductTitleTapped"
            CommandParameter="{Binding Link}" />
                                </Label.GestureRecognizers>
                            </Label>


                            <!-- Product details -->
                            <Label Text="{Binding ProductDetails}" 
                                   FontSize="12"
                                   TextColor="Gray" />

                            <!-- Store name -->
                            <Label Text="{Binding Store}" 
                                   FontSize="12" />

                            <!-- Price -->
                            <Label Text="{Binding Price, StringFormat='€{0:F2}'}" 
                                   TextColor="Green"
                                   FontAttributes="Bold" />

                            <!-- Best deal badge -->
                            <Label Text="🔥 Best Deal"
                                   TextColor="Red"
                                   FontAttributes="Bold"
                                   IsVisible="{Binding IsBestDeal}" />
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </VerticalStackLayout>
</ContentPage>